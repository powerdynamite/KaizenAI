---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faqs from '../components/Faqs.astro';
import { packages, packageGroups, packageTerms, packageFaqs, formatPrice, serviceHref } from '../data/packages';
import { breadcrumbs, faqPage, ORG_ID } from '../lib/schema';
import { SITE } from '../config';

const crumbs = [{ name: 'Packages', path: '/packages/' }];
const catalog = {
  '@type': 'OfferCatalog',
  '@id': `${SITE.url}/packages/#catalog`,
  name: 'KaizenAI fixed-price packages',
  url: `${SITE.url}/packages/`,
  provider: { '@id': ORG_ID },
  itemListElement: packages.map((p) => ({
    '@type': 'Offer',
    name: p.name,
    description: p.summary,
    url: `${SITE.url}/packages/#${p.id}`,
    priceSpecification: {
      '@type': p.group === 'monthly' ? 'UnitPriceSpecification' : 'PriceSpecification',
      price: p.price,
      priceCurrency: 'USD',
      ...(p.from ? { minPrice: p.price } : {}),
      ...(p.group === 'monthly' ? { unitText: 'MONTH' } : {}),
    },
  })),
};
const quoteHref = (topic: string, name: string) =>
  `/contact/?topic=${encodeURIComponent(topic)}&about=${encodeURIComponent(name)}`;
const bookingAttrs = SITE.bookingUrl ? { href: SITE.bookingUrl, target: '_blank', rel: 'noopener', 'data-booking': SITE.bookingUrl } : {};
---
<Base
  title="Fixed-Price Microsoft 365, Dynamics 365, Power Platform & Copilot Packages"
  description="Fixed-price packages from KaizenAI: Copilot readiness, Dynamics 365 health checks and implementations, Power Platform builds and governance, AI agents, Power BI and managed support."
  markdown="/packages.md"
  schema={[catalog, faqPage(packageFaqs, '/packages/'), breadcrumbs(crumbs)]}
>
  <section class="page-hero">
    <div class="container hero">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Fixed scope. Fixed price. Weeks, not months.</h1>
        <p class="lead">Pick a package, or tell us the problem and we will match one to it. The price is agreed before we start, and if we miss the agreed scope, we fix it at no extra cost.</p>
        <div class="actions"><a href="/contact/" {...bookingAttrs} class="btn">Get a fixed-price quote <span class="arr">→</span></a><a class="link-arrow" href="/experience/">See what we've delivered →</a></div>
      </div>
      <nav class="toc" aria-label="Packages on this page">
        <span class="label">On this page</span>
        <ol>
          {packageGroups.map((g, i) => (
            <li><a href={`#${g.id}`}><span>{String(i + 1).padStart(2, '0')}</span>{g.title}</a></li>
          ))}
          <li><a href="#how-it-works"><span>04</span>How fixed price works</a></li>
          <li><a href="#faq"><span>05</span>Questions</a></li>
        </ol>
      </nav>
    </div>
  </section>

  {packageGroups.map((g, gi) => (
    <section class={`section${gi === 1 ? ' section--tint' : ''}`} id={g.id}>
      <div class="container split">
        <div>
          <span class="big-n">{String(gi + 1).padStart(2, '0')}</span>
          <span class="label">{g.label}</span>
        </div>
        <div>
          <h2>{g.title}</h2>
          <p class="lead measure">{g.intro}</p>
          <ol class="pkgs">
            {packages.filter((p) => p.group === g.id).map((p) => (
              <li class="pkg" id={p.id}>
                <div class="pkg-head">
                  <h3>{p.name}</h3>
                  <p class="price">{formatPrice(p)}</p>
                </div>
                <p class="meta">{p.duration !== 'Monthly' && <span>Typical duration: {p.duration}</span>}<span>{p.summary}</span></p>
                <ul class="ticks">{p.includes.map((x) => <li>{x}</li>)}</ul>
                <p class="pkg-actions">
                  <a class="link-arrow" href={quoteHref(p.topic, p.name)} {...bookingAttrs}>{g.id === 'monthly' ? 'Talk to us' : 'Get a fixed-price quote'} →</a>
                  {serviceHref(p) && <a class="more" href={serviceHref(p)}>About this service</a>}
                </p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  ))}

  <section class="section" id="how-it-works">
    <div class="container split">
      <div><span class="big-n">04</span><span class="label">How it works</span></div>
      <div>
        <h2>How fixed price works</h2>
        <ol class="terms">
          {packageTerms.map((t) => <li><h3>{t.title}</h3><p>{t.body}</p></li>)}
        </ol>
        <p class="note">Not sure which package fits? <a href="/contact/" {...bookingAttrs}>Book a free 30-minute call</a> and we will recommend one, or tell you honestly if you don't need us.</p>
      </div>
    </div>
  </section>

  <Faqs faqs={packageFaqs} title="Before you book" />

  <CTA />
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; align-items: end; }
  .hero .lead { margin-bottom: 28px; }
  .hero h1 { max-width: 18ch; }
  .toc { border-top: 1px solid var(--rule-strong); padding-top: 14px; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li { border-bottom: 1px solid var(--rule); }
  .toc a { display: flex; gap: 16px; align-items: baseline; padding: 12px 0; text-decoration: none; color: var(--heading); font-family: var(--display); font-weight: 600; letter-spacing: -0.01em; }
  .toc a span { font-size: 0.78rem; color: var(--accent); font-weight: 700; }
  .toc a:hover { color: var(--accent); }
  .big-n { display: block; font-family: var(--display); font-weight: 700; font-size: clamp(2.6rem, 4vw, 3.6rem); line-height: 1; color: var(--vermilion); letter-spacing: -0.04em; margin-bottom: 12px; }
  .pkgs { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; }
  .pkg { padding: 22px 0 24px; border-top: 1px solid var(--rule); scroll-margin-top: 24px; }
  .pkg-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .pkg h3 { font-size: 1.12rem; margin: 0; }
  .price { margin: 0; font-family: var(--display); font-weight: 700; color: var(--accent); white-space: nowrap; font-size: 1.05rem; }
  .meta { margin: 6px 0 10px; color: var(--muted); font-size: 0.95rem; display: grid; gap: 2px; }
  .meta span:first-child:not(:only-child) { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--heading); }
  .ticks { list-style: none; margin: 0 0 14px; padding: 0; }
  .ticks li { position: relative; padding: 6px 0 6px 22px; border-top: 1px solid var(--rule); font-size: 0.93rem; color: var(--muted); }
  .ticks li::before { content: ''; position: absolute; left: 2px; top: 14px; width: 9px; height: 5px; border-left: 2px solid var(--vermilion); border-bottom: 2px solid var(--vermilion); transform: rotate(-45deg); }
  .pkg-actions { margin: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; }
  .more { font-size: 0.9rem; color: var(--muted); }
  .terms { list-style: none; margin: 24px 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; counter-reset: t; }
  .terms li { counter-increment: t; position: relative; padding: 16px 0 16px 2.4rem; border-top: 1px solid var(--rule); }
  .terms li::before { content: counter(t, decimal-leading-zero); position: absolute; left: 0; top: 19px; font-family: var(--display); font-weight: 700; font-size: 0.78rem; color: var(--accent); }
  .terms h3 { font-size: 1.05rem; margin: 0 0 4px; }
  .terms p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .note { color: var(--muted); }
  @media (max-width: 960px) { .hero { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .pkgs, .terms { grid-template-columns: 1fr; } }
</style>
