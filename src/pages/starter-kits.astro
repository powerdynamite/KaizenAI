---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Faqs from '../components/Faqs.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { kits, kitSteps, kitFaqs } from '../data/tools';
import { SITE } from '../config';
import { breadcrumbs, faqPage, FOUNDER_ID, ORG_ID } from '../lib/schema';

const path = '/starter-kits/';
const crumbs = [{ name: 'Starter kits', path }];
const code = kits.filter((k) => k.repo).map((k) => ({
  '@type': 'SoftwareSourceCode',
  name: `${k.name} (starter kit)`,
  description: k.tagline,
  codeRepository: k.repo,
  programmingLanguage: k.stack.join(', '),
  author: { '@id': FOUNDER_ID },
  publisher: { '@id': ORG_ID },
  url: `${SITE.url}${path}#${k.slug}`,
}));
---
<Base
  title="AI-Ready Power Platform Starter Kits"
  description="Starter kits for Dynamics 365 and Power Platform: working foundations, not finished products, that KaizenAI adapts to each organisation's own requirements."
  markdown="/starter-kits.md"
  schema={[...code, faqPage(kitFaqs, path), breadcrumbs(crumbs)]}
>
  <section class="page-hero">
    <div class="container hero">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Starter kits, not finished products.</h1>
        <p class="lead">
          Working foundations from our own Dynamics 365 and Power Platform delivery. Each one shows the approach and
          saves weeks of set-up. Then we plan your specific requirements with you, and adapt the kit to fit them.
        </p>
        <div class="actions">
          <a href="/contact/?topic=Something%20else" class="btn">Plan your version <span class="arr">→</span></a>
          <a href="#how" class="link-arrow">How it works</a>
        </div>
      </div>
      <nav class="toc" aria-label="Starter kits on this page">
        <span class="label">The kits</span>
        <ol>
          {kits.map((k, i) => (
            <li><a href={`#${k.slug}`}><span>{String(i + 1).padStart(2, '0')}</span>{k.name}</a></li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <section class="section section--tint" id="how">
    <div class="container split">
      <div>
        <span class="label"><b>→</b>How it works</span>
        <h2 class="side-h">From kit to your solution</h2>
        <p class="side-p">AI-ready means each kit is built so AI can help plan and adapt it. People review every change.</p>
      </div>
      <div class="cols steps">
        {kitSteps.map((s, i) => (
          <div class="col"><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{s.title}</h3><p>{s.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  {kits.map((k, i) => (
    <section class="section kit" id={k.slug}>
      <div class="container split">
        <div>
          <span class="big-n">{String(i + 1).padStart(2, '0')}</span>
          <span class:list={['status', { private: !k.repo }]}>{k.maturity}</span>
          <p class="side-sub">Built with</p>
          <p class="tags">{k.stack.map((s) => <span>{s}</span>)}</p>
          <p class="side-sub">AI-ready</p>
          <p class="side-p">{k.ai}</p>
        </div>
        <div>
          <h2>{k.name}</h2>
          <p class="definition">{k.tagline}</p>
          <p class="lead problem"><strong>The problem.</strong> {k.problem}</p>
          <div class="two">
            <div>
              <h3 class="sub">What you start with</h3>
              <ul class="list">{k.startWith.map((f) => <li>{f}</li>)}</ul>
            </div>
            <div>
              <h3 class="sub">What we tailor for you</h3>
              <ul class="list tailor">{k.customise.map((f) => <li>{f}</li>)}</ul>
            </div>
          </div>
          <div class="actions">
            <a class="btn" href={`/contact/?topic=Something%20else`}>Plan your version <span class="arr">→</span></a>
            {k.repo ? (
              <a class="link-arrow" href={k.repo} rel="noopener" target="_blank">Explore the code on GitHub</a>
            ) : (
              <span class="muted note">Code not public yet. Ask for a walkthrough.</span>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <Faqs faqs={kitFaqs} title="Starter kits: honest answers" />

  <CTA title="Have requirements a kit almost fits?" body="Tell us what you need. We will show you how close a kit gets, and what tailoring the rest would involve." />
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; align-items: end; }
  .hero .lead { margin-bottom: 28px; }
  .toc { border-top: 1px solid var(--rule-strong); padding-top: 14px; }
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li { border-bottom: 1px solid var(--rule); }
  .toc a { display: flex; gap: 16px; align-items: baseline; padding: 12px 0; text-decoration: none; color: var(--heading); font-family: var(--display); font-weight: 600; }
  .toc a span { font-size: 0.78rem; color: var(--accent); font-weight: 700; }
  .toc a:hover { color: var(--accent); }
  .steps { grid-template-columns: repeat(2, 1fr); }
  .big-n { display: block; font-family: var(--display); font-weight: 700; font-size: clamp(2.6rem, 4vw, 3.6rem); line-height: 1; color: var(--vermilion); letter-spacing: -0.04em; margin-bottom: 14px; }
  .status { display: inline-block; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--teal); border: 1px solid currentColor; border-radius: 999px; padding: 3px 10px; max-width: 30ch; }
  .status.private { color: var(--muted); }
  .side-sub { margin: 24px 0 6px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--heading); }
  .kit .tags { max-width: 30ch; }
  .problem strong { color: var(--heading); font-weight: 600; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 0 40px; margin: 24px 0 30px; }
  .sub { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); font-family: var(--sans); padding-bottom: 10px; border-bottom: 1px solid var(--rule-strong); margin: 0; }
  .list { list-style: none; margin: 0; padding: 0; }
  .list li { position: relative; padding: 12px 0 12px 22px; border-bottom: 1px solid var(--rule); font-size: 0.97rem; }
  .list li::before { content: ''; position: absolute; left: 2px; top: 21px; width: 8px; height: 8px; border-radius: 2px; background: var(--rule-strong); }
  .tailor li::before { background: var(--vermilion); }
  .note { font-size: 0.92rem; }
  @media (max-width: 960px) { .hero { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .two, .steps { grid-template-columns: 1fr; } }
</style>
