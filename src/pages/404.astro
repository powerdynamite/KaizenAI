---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section"><div class="container" style="text-align:center;max-width:640px">
    <span class="eyebrow">404</span>
    <h1>This page took a step too far</h1>
    <p class="lead" style="margin-inline:auto">The page you are looking for does not exist or has moved.</p>
    <div class="btn-row" style="justify-content:center"><a href="/" class="btn btn--primary">Back to home</a><a href="/contact/" class="btn btn--ghost">Contact us</a></div>
  </div></section>
</Base>
