---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---
<Base title="Page not found" noindex>
  <section class="page-hero"><div class="container nf">
    <Logo variant="open" size={96} wordmark={false} />
    <div>
      <span class="label"><b>404</b>Not found</span>
      <h1>This page took a step too far.</h1>
      <p class="lead">The page you are looking for does not exist or has moved.</p>
      <div class="actions"><a href="/" class="btn">Back to home <span class="arr">→</span></a><a href="/contact/" class="link-arrow">Contact us</a></div>
    </div>
  </div></section>
</Base>
<style>.nf { display: grid; grid-template-columns: auto 1fr; gap: 40px; align-items: start; } @media (max-width: 600px) { .nf { grid-template-columns: 1fr; } }</style>
