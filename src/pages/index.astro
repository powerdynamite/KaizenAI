---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
import Faqs from '../components/Faqs.astro';
import Logo from '../components/Logo.astro';
import Kanji from '../components/Kanji.astro';
import { Image } from 'astro:assets';
import gantt from '../assets/ppm/the-interactive-gantt.png';
import { services } from '../data/services';
import { PPM, capabilities } from '../data/ppm';
import { homeFaqs } from '../data/faq';
import { steps, principles } from '../data/home';
import { faqPage } from '../lib/schema';
import { publishedPosts } from '../lib/markdown';

const posts = (await publishedPosts()).slice(0, 3);
const roman = ['i.', 'ii.', 'iii.'];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---
<Base markdown="/index.md" schema={[faqPage(homeFaqs, '/')]}>
  <section class="hero">
    <div class="container">
      <span class="label">A Microsoft &amp; AI practice · Lahore, working worldwide</span>
      <div class="hero-top">
        <h1>AI agents and Copilot, built on the Microsoft stack <em>you already run.</em></h1>
        <div class="hero-mark" aria-hidden="true">
          <Logo variant="open" size={132} wordmark={false} />
          <Kanji height={26} class="hero-kanji" />
          <span class="label">Continuous improvement</span>
        </div>
      </div>
      <div class="hero-foot">
        <div>
          <p class="lead">
            KaizenAI builds AI agents, rolls out Copilot and Cowork, and implements Dynamics 365 and the
            Power Platform on secure Azure foundations. We start small and improve a little every week.
          </p>
          <div class="actions">
            <a href="/contact/" class="btn">Book a free consultation <span class="arr">→</span></a>
            <a href="/products/kaizen-ppm/" class="link-arrow">See Kaizen PPM</a>
          </div>
        </div>
        <dl class="dl index">
          <dt>Practice</dt><dd>{services.map((s) => s.title).join(' · ')}</dd>
          <dt>Product</dt><dd><a href={PPM.path}>Kaizen PPM</a>, portfolio management on Dataverse</dd>
          <dt>Based</dt><dd>Lahore, Pakistan, working remotely</dd>
          <dt>Replies</dt><dd>Within one working day</dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="label"><b>01</b>Services</span>
        <h2 class="side-h">What we do</h2>
        <p class="muted side-p">AI first, on Microsoft foundations that make it work in practice.</p>
      </div>
      <ol class="rows">
        {services.map((s, i) => (
          <li>
            <a class="row-link" href={`/services/${s.slug}/`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="title">{s.title}</span>
              <span class="desc">{s.short}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="split">
        <div>
          <span class="label"><b>02</b>Product</span>
        </div>
        <div>
          <h2>Kaizen PPM</h2>
          <p class="definition">Project and portfolio management that lives inside your own Dataverse, from first idea to closed project.</p>
          <ol class="feature-list">
            {capabilities.slice(0, 6).map((c) => (
              <li><strong>{c.title}.</strong> <span class="muted">{c.body}</span></li>
            ))}
          </ol>
          <div class="actions">
            <a class="btn" href={PPM.path}>Explore Kaizen PPM <span class="arr">→</span></a>
            <a class="link-arrow" href="/contact/?topic=Kaizen%20PPM%20demo">Request a demo</a>
          </div>
        </div>
      </div>
      <figure class="figure product-shot">
        <Image src={gantt} alt="Kaizen PPM interactive Gantt chart with WBS grid, dependencies and milestones" widths={[800, 1280, 1918]} sizes="(max-width: 1240px) 100vw, 1144px" />
        <figcaption>Fig. 1. The Kaizen PPM schedule view: WBS, dependencies, baselines, drag to reschedule.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="label"><b>03</b>Method</span>
      </div>
      <div>
        <h2>Small steps that compound.</h2>
        <p class="lead measure">
          <em>Kaizen</em> (改善) is the Japanese practice of continuous improvement. We apply it to software: ship something
          useful early, measure it, then make it better each cycle.
        </p>
        <div class="cols method">
          {steps.map((s, i) => (
            <div class="col">
              <span class="n">{roman[i]}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container split">
      <div>
        <span class="label"><b>04</b>Commitments</span>
      </div>
      <ul class="commit">
        {principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container split">
        <div>
          <span class="label"><b>05</b>Journal</span>
          <h2 class="side-h">Notes on AI and Microsoft</h2>
          <a href="/blog/" class="link-arrow">All articles</a>
        </div>
        <ol class="rows">
          {posts.map((p) => (
            <li>
              <a class="row-link post" href={`/blog/${p.id}/`}>
                <span class="num">{fmt(p.data.date)}</span>
                <span class="title">{p.data.title}</span>
                <span class="desc">{p.data.category}</span>
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <Faqs faqs={homeFaqs} title="Questions people ask us" />

  <CTA />
</Base>

<style>
  .hero { padding: clamp(56px, 9vw, 112px) 0 clamp(56px, 8vw, 96px); position: relative; overflow: hidden; }
  .hero .container { position: relative; }
  .hero-top { display: grid; grid-template-columns: 1fr auto; gap: 48px; align-items: start; }
  .hero h1 { max-width: 16ch; margin: 0.15em 0 0.6em; font-size: clamp(2.5rem, 5.8vw, 4.8rem); }
  .hero h1 em { color: var(--vermilion); }
  .hero-mark { display: grid; justify-items: center; gap: 16px; padding: 18px 8px 0 0; }
  .hero-mark :global(.hero-kanji) { color: var(--heading); }
  .hero-mark .label { margin: 0; }
  .hero-foot { display: grid; grid-template-columns: 1.25fr 1fr; gap: 48px; align-items: end; border-top: 1px solid var(--rule-strong); padding-top: 32px; }
  .hero-foot .lead { margin-bottom: 28px; }
  .index { align-self: start; }

  .side-h { font-size: clamp(1.6rem, 2.6vw, 2.2rem); max-width: 10ch; }
  .side-p { max-width: 26ch; font-size: 0.95rem; }

  .feature-list { list-style: none; padding: 0; margin: 28px 0 36px; columns: 2; column-gap: 40px; counter-reset: f; }
  .feature-list li { break-inside: avoid; padding: 14px 0 14px 2.4rem; border-top: 1px solid var(--rule); position: relative; counter-increment: f; }
  .feature-list li::before { content: counter(f, decimal-leading-zero); position: absolute; left: 0; top: 16px; font-family: var(--display); font-weight: 700; font-size: 0.78rem; color: var(--accent); }
  .feature-list strong { font-weight: 500; color: var(--heading); }
  .product-shot { margin-top: clamp(48px, 7vw, 88px); }

  .method { margin-top: 48px; grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 760px) { .method { grid-template-columns: 1fr; } }

  .commit { list-style: none; margin: 0; padding: 0; }
  .commit li { display: grid; grid-template-columns: 1fr 1.3fr; gap: 12px 40px; padding: 28px 0; border-top: 1px solid var(--rule); }
  .commit li:first-child { border-top-color: var(--rule-strong); }
  .commit h3 { margin: 0; font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .commit p { margin: 0; color: #c9d1de; }

  .post .num { white-space: nowrap; }
  .post { grid-template-columns: 7.5rem 1.6fr 0.8fr 2rem; }

  @media (max-width: 1100px) { .hero-mark { display: none; } .hero-top { grid-template-columns: 1fr; } }
  @media (max-width: 960px) { .hero-foot { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .hero-mark { display: none; }
    .feature-list { columns: 1; }
    .commit li { grid-template-columns: 1fr; }
    .post { grid-template-columns: 1fr 1.2rem; }
    .post .num { grid-column: 1; }
    .post .title { grid-column: 1; }
    .post .desc { display: none; }
    .post .go { grid-row: 1 / 3; grid-column: 2; align-self: center; }
  }
</style>
