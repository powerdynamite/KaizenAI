---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { services } from '../data/services';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const steps = [
  { n: '01', title: 'Discover', body: 'We start from the business problem rather than the licence. We map the process, the data and what "better" would look like in numbers.' },
  { n: '02', title: 'Build small', body: 'We ship a working slice in weeks so people can use it, and their feedback shapes the next slice.' },
  { n: '03', title: 'Improve continuously', body: 'Kaizen means change for the better. After go-live we measure, tune and automate a little more each cycle.' },
];

const principles = [
  { icon: 'lock', title: 'Your data stays yours', body: 'Solutions live in your own Microsoft 365 and Azure tenant. Nothing is locked into our systems.' },
  { icon: 'user', title: 'Humans stay in charge', body: 'Our AI agents draft, flag and propose. A person approves anything that matters.' },
  { icon: 'loop', title: 'Built to be maintained', body: 'Source-controlled solutions, documented decisions and deployment pipelines, not one-off clicks.' },
];
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Microsoft ecosystem · Agentic AI</span>
        <h1>Better every day, with <span class="hl">Microsoft</span> and <span class="hl">AI</span>.</h1>
        <p class="lead">
          KaizenAI helps organisations run on Dynamics 365 and the Power Platform, put Copilot and AI agents to work,
          and keep it all on secure, automated cloud foundations.
        </p>
        <div class="btn-row">
          <a href="/contact/" class="btn btn--primary">Book a free consultation <Icon name="arrow" size={18} /></a>
          <a href="/products/kaizen-ppm/" class="btn btn--ghost">See Kaizen PPM</a>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 420 360" role="presentation">
          <defs>
            <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#E2492F" />
              <stop offset="1" stop-color="#C23A22" />
            </linearGradient>
          </defs>
          <g class="grid-lines" stroke="currentColor" stroke-opacity="0.12">
            <line x1="20" y1="320" x2="400" y2="320" />
            <line x1="20" y1="240" x2="400" y2="240" stroke-dasharray="4 6" />
            <line x1="20" y1="160" x2="400" y2="160" stroke-dasharray="4 6" />
            <line x1="20" y1="80" x2="400" y2="80" stroke-dasharray="4 6" />
          </g>
          <rect class="bar b1" x="40" y="250" width="56" height="70" rx="10" />
          <rect class="bar b2" x="120" y="205" width="56" height="115" rx="10" />
          <rect class="bar b3" x="200" y="160" width="56" height="160" rx="10" />
          <rect class="bar b4" x="280" y="90" width="56" height="230" rx="10" fill="url(#g1)" />
          <path d="M68 235 L148 190 L228 145 L308 70" fill="none" stroke="#E2492F" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 8" />
          <circle cx="308" cy="70" r="7" fill="#E2492F" />
          <circle cx="308" cy="70" r="16" fill="#E2492F" fill-opacity="0.18" />
        </svg>
        <div class="float f1"><Icon name="crm" size={18} /> Dynamics 365</div>
        <div class="float f2"><Icon name="copilot" size={18} /> Copilot & Cowork</div>
        <div class="float f3"><Icon name="agent" size={18} /> AI agents</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Five practices on one Microsoft foundation</h2>
        <p class="lead">From CRM to cloud security, every service is built on the same Microsoft stack, so the pieces work together.</p>
      </div>
      <div class="grid grid--3">
        {services.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <div class="icon-tile"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p class="muted">{s.short}</p>
            <span class="more">Learn more →</span>
          </a>
        ))}
        <a class="card card--product" href="/products/kaizen-ppm/">
          <div class="icon-tile"><Icon name="gantt" /></div>
          <span class="badge">Our product</span>
          <h3 style="margin-top:10px">Kaizen PPM</h3>
          <p class="muted">Project & portfolio management that lives inside your own Dataverse.</p>
          <span class="more">Explore the product →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container product">
      <div>
        <span class="eyebrow">Product · Kaizen PPM</span>
        <h2>Run every project and portfolio in Power Platform</h2>
        <p class="lead">
          Kaizen PPM covers ideas, proposals, projects and programs. It includes an interactive Gantt, Kanban boards,
          financials, resource planning and risk management, built natively on Dataverse.
        </p>
        <ul class="checklist">
          <li>A natural home for teams leaving Microsoft Project Online</li>
          <li>Data stays in your own Microsoft 365 tenant</li>
          <li>Copilot and Cowork ready, with AI that explains and never decides for you</li>
        </ul>
        <div class="btn-row" style="margin-top:24px">
          <a class="btn btn--primary" href="/products/kaizen-ppm/">Explore Kaizen PPM</a>
          <a class="btn btn--ghost" href="/contact/?topic=Kaizen%20PPM%20demo">Request a demo</a>
        </div>
      </div>
      <figure class="shot">
        <img src="/images/ppm/the-interactive-gantt.png" alt="Kaizen PPM interactive Gantt chart with WBS grid, dependencies and milestones" width="1918" height="670" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How we work</span>
        <h2>The Kaizen way: small steps, compounding results</h2>
      </div>
      <div class="grid grid--3">
        {steps.map((s) => (
          <div class="step">
            <span class="num">{s.n}</span>
            <h3>{s.title}</h3>
            <p class="muted">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Principles</span>
        <h2>What you can count on</h2>
      </div>
      <div class="grid grid--3">
        {principles.map((p) => (
          <div class="card">
            <div class="icon-tile"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p class="muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head row-head">
          <div>
            <span class="eyebrow">From the blog</span>
            <h2>Notes on Microsoft and AI</h2>
          </div>
          <a href="/blog/" class="btn btn--ghost">All articles</a>
        </div>
        <div class="grid grid--3">
          {posts.map((p) => (
            <a class="card" href={`/blog/${p.id}/`}>
              <span class="badge badge--teal">{p.data.category}</span>
              <h3 style="margin-top:12px">{p.data.title}</h3>
              <p class="muted">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTA />
</Base>

<style>
  .hero { padding: clamp(48px, 8vw, 104px) 0 clamp(48px, 7vw, 88px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: center; }
  .hero .lead { margin-bottom: 30px; }
  .hl { color: var(--vermilion); }
  .hero-art { position: relative; color: var(--heading); }
  .hero-art svg { width: 100%; height: auto; }
  .bar { fill: var(--ink-2); }
  @media (prefers-color-scheme: dark) { .bar { fill: #2a3650; } }
  .bar.b4 { fill: url(#g1); }
  .float {
    position: absolute; display: flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
    padding: 8px 14px; border-radius: 999px; font-size: 0.85rem; font-weight: 600;
    font-family: var(--font-head); color: var(--heading); white-space: nowrap;
  }
  .float :global(svg) { color: var(--vermilion); }
  .f1 { top: 6%; left: 0; }
  .f2 { top: 42%; right: -2%; }
  .f3 { bottom: 4%; left: 14%; }

  .card--product { border-color: var(--vermilion); }

  .product { display: grid; grid-template-columns: 1fr 1.15fr; gap: 48px; align-items: center; }
  .shot { margin: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); background: #fff; }

  .step { border-top: 2px solid var(--line); padding-top: 22px; }
  .num { font-family: var(--font-head); font-weight: 700; color: var(--vermilion); font-size: 0.95rem; display: block; margin-bottom: 10px; }

  .row-head { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }

  @media (max-width: 900px) {
    .hero-grid, .product { grid-template-columns: 1fr; }
    .hero-art { max-width: 460px; }
    .f2 { right: 0; }
  }
</style>
