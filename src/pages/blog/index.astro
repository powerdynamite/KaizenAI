---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../config';
import { publishedPosts } from '../../lib/markdown';
import { ORG_ID, breadcrumbs } from '../../lib/schema';
const posts = await publishedPosts();
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
const blog = {
  '@type': 'Blog',
  '@id': `${SITE.url}/blog/#blog`,
  name: 'KaizenAI Blog',
  url: `${SITE.url}/blog/`,
  publisher: { '@id': ORG_ID },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: `${SITE.url}/blog/${p.id}/`, datePublished: p.data.date.toISOString() })),
};
---
<Base
  title="Blog: AI Agents, Copilot, Dynamics 365 & Power Platform"
  description="Practical, no-hype notes on AI agents, Microsoft 365 Copilot and Cowork, Dynamics 365, Power Platform and DevSecOps from KaizenAI."
  markdown="/blog.md"
  schema={[blog, breadcrumbs([{ name: 'Blog', path: '/blog/' }])]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Blog', path: '/blog/' }]} />
      <h1>Journal</h1>
      <p class="lead">Practical, no-hype notes on AI and Microsoft from our delivery work. <a href="/rss.xml">Subscribe via RSS</a>.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <ol class="rows">
        {posts.map((p) => (
          <li>
            <a class="row-link post" href={`/blog/${p.id}/`}>
              <span class="num"><time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time></span>
              <span class="title">{p.data.title}</span>
              <span class="desc">{p.data.description}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  .post { grid-template-columns: 8rem 1.3fr 1.2fr 2rem; }
  .post .num { white-space: nowrap; }
  @media (max-width: 760px) {
    .post { grid-template-columns: 1fr 1.2rem; }
    .post .num, .post .title, .post .desc { grid-column: 1; }
    .post .go { grid-row: 1 / 4; grid-column: 2; align-self: center; }
  }
</style>
