---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article>
    <header class="page-hero">
      <div class="container narrow">
        <a href="/blog/" class="back">← All articles</a>
        <span class="badge badge--teal">{post.data.category}</span>
        <h1 class="title">{post.data.title}</h1>
        <p class="muted">By {post.data.author} · <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
      </div>
    </header>
    <div class="section">
      <div class="container narrow prose"><Content /></div>
    </div>
  </article>
  <CTA />
</Base>
<style>
  .narrow { max-width: 780px; }
  .back { display: block; margin-bottom: 18px; text-decoration: none; font-weight: 500; }
  .title { margin-top: 14px; font-size: clamp(2rem, 4.2vw, 3rem); }
</style>
