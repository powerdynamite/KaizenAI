---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { render } from 'astro:content';
import { publishedPosts } from '../../lib/markdown';
import { SITE } from '../../config';
import { ORG_ID, FOUNDER_ID, breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const path = `/blog/${post.id}/`;
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const fmt = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const crumbs = [{ name: 'Blog', path: '/blog/' }, { name: d.title, path }];
const article = {
  '@type': 'BlogPosting',
  '@id': `${SITE.url}${path}#article`,
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@id': FOUNDER_ID, '@type': 'Person', name: d.author, url: `${SITE.url}/about/` },
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: `${SITE.url}${path}`,
  image: `${SITE.url}${d.image ?? '/og-image.png'}`,
  articleSection: d.category,
  keywords: d.tags.join(', ') || undefined,
  wordCount: words,
  inLanguage: 'en',
};
---
<Base
  title={d.title}
  description={d.description}
  type="article"
  image={d.image}
  markdown={`/blog/${post.id}.md`}
  publishedTime={d.date}
  modifiedTime={d.updated ?? d.date}
  schema={[article, breadcrumbs(crumbs)]}
>
  <article>
    <header class="page-hero">
      <div class="container">
        <Breadcrumbs items={crumbs} />
        <span class="label"><b>{d.category}</b>{minutes} min read</span>
        <h1 class="title">{d.title}</h1>
        <p class="dek">{d.description}</p>
        <p class="byline">
          By <a href="/about/#founder" rel="author">{d.author}</a>, founder of KaizenAI ·
          <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>
          {d.updated && <> · updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time></>}
        </p>
      </div>
    </header>
    <div class="section">
      <div class="container"><div class="prose"><Content /></div></div>
    </div>
  </article>
  <CTA />
</Base>
<style>
  .title { max-width: 22ch; font-size: clamp(2.1rem, 4.6vw, 3.6rem); }
  .dek { font-size: 1.25rem; color: var(--muted); max-width: 48ch; }
  .byline { font-size: 0.88rem; color: var(--muted); border-top: 1px solid var(--rule-strong); padding-top: 16px; margin-top: 32px; }
  .byline a { color: var(--heading); }
  .prose { margin-left: auto; margin-right: auto; }
</style>
