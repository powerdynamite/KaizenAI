---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PPM } from '../../data/ppm';
import { breadcrumbs } from '../../lib/schema';
const crumbs = [{ name: 'Products', path: '/products/' }];
---
<Base title="Power Platform Products" description="Products from KaizenAI built natively on Microsoft Power Platform and Dataverse, including Kaizen PPM for project and portfolio management." schema={[breadcrumbs(crumbs)]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Products built on Power Platform.</h1>
      <p class="lead">Lessons from client work, packaged as products you install into your own Dataverse environment.</p>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div><span class="label"><b>01</b>Available</span></div>
      <ol class="rows">
        <li>
          <a class="row-link" href={PPM.path}>
            <span class="num">01</span>
            <span class="title">Kaizen PPM</span>
            <span class="desc">{PPM.definition}</span>
            <span class="go" aria-hidden="true">→</span>
          </a>
        </li>
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div><span class="label"><b>02</b>In the workshop</span></div>
      <p class="lead">Agent templates and Power Platform accelerators from our delivery work are being packaged next. <a href="/blog/">Follow the journal</a> for updates.</p>
    </div>
  </section>
  <CTA />
</Base>
