---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Faqs from '../../components/Faqs.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Image, getImage } from 'astro:assets';
import gantt from '../../assets/ppm/the-interactive-gantt.png';
import dashboard from '../../assets/ppm/executive-dashboard.png';
import kanban from '../../assets/ppm/the-kanban-board.png';
import finance from '../../assets/ppm/budget-forecast-actual.png';
import resources from '../../assets/ppm/resource-management-standalone.png';
import { PPM, capabilities, ladder, migrationSources, ppmFaqs } from '../../data/ppm';
import { ppmSoftware, faqPage, breadcrumbs } from '../../lib/schema';

const shots = [
  { src: dashboard, alt: 'Kaizen PPM executive dashboard with portfolio health, cost roll-up and timeline', caption: 'Executive dashboard' },
  { src: kanban, alt: 'Kaizen PPM Kanban board with task cards grouped in buckets', caption: 'Kanban board' },
  { src: finance, alt: 'Kaizen PPM financial grid showing budget, forecast and actuals by period', caption: 'Budget, forecast & actuals' },
  { src: resources, alt: 'Kaizen PPM resource management capacity view', caption: 'Resource management' },
];
const shotUrls = await Promise.all([gantt, ...shots.map((s) => s.src)].map(async (img) => (await getImage({ src: img, format: 'png' })).src));
const crumbs = [{ name: 'Products', path: '/products/' }, { name: 'Kaizen PPM', path: PPM.path }];
---
<Base
  title={PPM.seoTitle}
  description={PPM.metaDescription}
  markdown="/products/kaizen-ppm.md"
  schema={[ppmSoftware(PPM.definition, shotUrls), faqPage(ppmFaqs, PPM.path), breadcrumbs(crumbs)]}
>
  <section class="page-hero">
    <div class="container hero">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Project & portfolio management that lives in your Dataverse</h1>
        <p class="definition">{PPM.definition}</p>
        <p class="lead">{PPM.intro}</p>
        <div class="btn-row">
          <a href="/contact/?topic=Kaizen%20PPM%20demo" class="btn btn--primary">Request a demo</a>
          <a href="#capabilities" class="btn btn--ghost">See capabilities</a>
        </div>
      </div>
      <ul class="facts">
        <li><strong>100%</strong><span>inside your own Microsoft 365 tenant</span></li>
        <li><strong>10</strong><span>capability areas, idea to close</span></li>
        <li><strong>Native</strong><span>Dataverse security, Power BI and Teams</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <figure class="shot big">
        <Image src={gantt} alt="Kaizen PPM Gantt chart with WBS grid, dependencies and milestones" widths={[800, 1280, 1918]} sizes="(max-width: 1160px) 100vw, 1120px" loading="eager" />
        <figcaption>The interactive Gantt: WBS, dependencies, baselines, drag-to-reschedule and MS Project export.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--alt" id="capabilities">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Capabilities</span>
        <h2>What does Kaizen PPM include?</h2>
        <p class="lead">Everything a PMO runs on, in one Dataverse data model.</p>
      </div>
      <div class="grid grid--3">
        {capabilities.map((c) => (
          <div class="cap"><h3>{c.title}</h3><p class="muted">{c.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">A closer look</span><h2>Built for real delivery work</h2></div>
      <div class="grid shots">
        {shots.map((s) => (
          <figure class="shot">
            <Image src={s.src} alt={s.alt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 560px" />
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Copilot & Cowork</span>
        <h2>How does Kaizen PPM use AI?</h2>
        <p>
          Kaizen PPM is being extended with Microsoft Copilot and Cowork. Our rule is simple: AI helps you get data in and
          answers out, and explains the numbers. It never quietly sets a project’s health or makes the call for you.
        </p>
      </div>
      <ol class="ladder">
        {ladder.map((l, i) => (
          <li>
            <span class="rung">{i + 1}</span>
            <div><h3>{l.rung}</h3><span class="who">{l.who}</span><p>{l.body}</p></div>
          </li>
        ))}
      </ol>
      <p class="note">AI features are rolling out in waves. Each one is security-trimmed to the user, labelled when AI-assisted, and can be switched off per environment. Ask us what is available today.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Migration</span>
        <h2>Leaving Project Online or Planner?</h2>
        <p class="lead">Every record in Kaizen PPM can carry its source-system lineage: where it came from, its original ID and when it last synced. Bringing your history across does not mean restructuring later.</p>
      </div>
      <ul class="checklist">
        {migrationSources.map((m) => <li>{m}</li>)}
      </ul>
    </div>
  </section>

  <Faqs faqs={ppmFaqs} title="Kaizen PPM: common questions" />

  <CTA title="See Kaizen PPM on your own projects" body="Book a walkthrough. We can load a sample of your real project data so you see how it fits." />
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: center; }
  .definition { font-size: 1.12rem; color: var(--heading); max-width: 62ch; border-left: 3px solid var(--vermilion); padding-left: 16px; }
  .facts { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .facts li { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; }
  .facts strong { display: block; font-family: var(--font-head); font-size: 1.6rem; color: var(--accent); }
  .facts span { color: var(--muted); font-size: 0.95rem; }
  .shot { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--card); box-shadow: var(--shadow); }
  .shot :global(img) { background: #fff; width: 100%; height: auto; }
  .shot figcaption { padding: 12px 18px; font-size: 0.9rem; color: var(--muted); border-top: 1px solid var(--line); }
  .shots { grid-template-columns: 1fr 1fr; }
  .cap { border-top: 2px solid var(--vermilion); padding-top: 18px; }
  .ladder { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .ladder li { background: var(--ink-2); border: 1px solid #2a3650; border-radius: var(--radius); padding: 22px; display: grid; gap: 12px; align-content: start; }
  .ladder li:last-child { border-color: var(--accent); }
  .rung { width: 34px; height: 34px; border-radius: 50%; background: var(--accent-btn); color: #fff; display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; }
  .ladder h3 { margin: 0; }
  .who { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; color: #f2a493; }
  .ladder p { margin: 8px 0 0; font-size: 0.95rem; }
  .note { margin-top: 28px; font-size: 0.92rem; color: #9aa5b8; max-width: 80ch; }
  .split { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; }
  @media (max-width: 960px) { .ladder { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .hero, .split { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .shots { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .ladder { grid-template-columns: 1fr; } }
</style>
