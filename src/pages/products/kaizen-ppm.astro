---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Faqs from '../../components/Faqs.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { Image, getImage } from 'astro:assets';
import gantt from '../../assets/ppm/the-interactive-gantt.png';
import dashboard from '../../assets/ppm/executive-dashboard.png';
import kanban from '../../assets/ppm/the-kanban-board.png';
import finance from '../../assets/ppm/budget-forecast-actual.png';
import resources from '../../assets/ppm/resource-management-standalone.png';
import { PPM, capabilities, ladder, migrationSources, ppmFaqs } from '../../data/ppm';
import { ppmSoftware, faqPage, breadcrumbs } from '../../lib/schema';

const shots = [
  { src: dashboard, alt: 'Kaizen PPM executive dashboard with portfolio health, cost roll-up and timeline', caption: 'Executive dashboard' },
  { src: kanban, alt: 'Kaizen PPM Kanban board with task cards grouped in buckets', caption: 'Kanban board' },
  { src: finance, alt: 'Kaizen PPM financial grid showing budget, forecast and actuals by period', caption: 'Budget, forecast and actuals' },
  { src: resources, alt: 'Kaizen PPM resource management capacity view', caption: 'Resource management' },
];
const shotUrls = await Promise.all([gantt, ...shots.map((s) => s.src)].map(async (img) => (await getImage({ src: img, format: 'png' })).src));
const crumbs = [{ name: 'Products', path: '/products/' }, { name: 'Kaizen PPM', path: PPM.path }];
---
<Base
  title={PPM.seoTitle}
  description={PPM.metaDescription}
  markdown="/products/kaizen-ppm.md"
  schema={[ppmSoftware(PPM.definition, shotUrls), faqPage(ppmFaqs, PPM.path), breadcrumbs(crumbs)]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="label"><b>Product</b>Kaizen PPM</span>
      <h1>Kaizen PPM</h1>
      <div class="intro">
        <p class="definition">{PPM.definition}</p>
        <div>
          <p class="lead">{PPM.intro}</p>
          <div class="actions">
            <a href="/contact/?topic=Kaizen%20PPM%20demo" class="btn">Request a demo <span class="arr">→</span></a>
            <a href="#capabilities" class="link-arrow">What’s included</a>
          </div>
        </div>
      </div>
      <dl class="facts">
        <div><dt>Data</dt><dd>Stays in your own Microsoft 365 tenant</dd></div>
        <div><dt>Scope</dt><dd>10 capability areas, idea to close</dd></div>
        <div><dt>Platform</dt><dd>Dataverse security, Power BI, Teams</dd></div>
      </dl>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <figure class="figure">
        <Image src={gantt} alt="Kaizen PPM Gantt chart with WBS grid, dependencies and milestones" widths={[800, 1280, 1918]} sizes="(max-width: 1240px) 100vw, 1144px" loading="eager" />
        <figcaption>Fig. 1. Schedule view: WBS, dependencies, baselines, drag to reschedule, MS Project export.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="capabilities">
    <div class="container split">
      <div>
        <span class="label"><b>01</b>Capabilities</span>
        <h2 class="side-h">What does Kaizen PPM include?</h2>
      </div>
      <ol class="caps">
        {capabilities.map((c) => (
          <li><h3>{c.title}</h3><p>{c.body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><span class="label"><b>02</b>Screens</span><h2 class="side-h">A closer look</h2><p class="side-p">Real screens from the product: dashboards, boards, financials and resourcing.</p><p class="side-note"><strong>Want the full tour?</strong><a href="/contact/?topic=Kaizen%20PPM%20demo">Request a demo →</a></p></div>
      <div class="shots">
        {shots.map((s, i) => (
          <figure class="figure">
            <Image src={s.src} alt={s.alt} widths={[480, 800, 1200]} sizes="(max-width: 860px) 100vw, 440px" />
            <figcaption>Fig. {i + 2}. {s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container split">
      <div>
        <span class="label"><b>03</b>Copilot &amp; Cowork</span>
      </div>
      <div>
        <h2>How does Kaizen PPM use AI?</h2>
        <p class="lead measure">
          AI helps you get data in and answers out, and explains the numbers. It never quietly sets a project’s health or
          makes the call for you. Four rungs, and AI stops before the last one.
        </p>
        <div class="cols ladder">
          {ladder.map((l, i) => (
            <div class="col">
              <span class="n">Rung {i + 1}</span>
              <h3>{l.rung}</h3>
              <p class="who">{l.who}</p>
              <p>{l.body}</p>
            </div>
          ))}
        </div>
        <p class="note">AI features are rolling out in waves. Each is security-trimmed to the user, labelled when AI-assisted, and can be switched off per environment.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><span class="label"><b>04</b>Migration</span><p class="side-p">Bring your history with you, without restructuring later.</p></div>
      <div>
        <h2>Leaving Project Online or Planner?</h2>
        <p class="lead measure">Every record in Kaizen PPM can carry its source-system lineage: where it came from, its original ID and when it last synced. Bringing your history across does not mean restructuring later.</p>
        <p class="tags sources">{migrationSources.map((m) => <span>{m}</span>)}</p>
      </div>
    </div>
  </section>

  <Faqs faqs={ppmFaqs} title="Kaizen PPM: common questions" />

  <CTA title="See it on your own projects." body="Book a walkthrough. We can load a sample of your real project data so you see how it fits." />
</Base>
<style>
  .intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; border-top: 1px solid var(--rule-strong); padding-top: 32px; margin-top: 12px; }
  .intro .lead { margin-bottom: 28px; }
  .facts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: 48px 0 0; border-top: 1px solid var(--rule); }
  .facts div { padding: 16px 20px 0 0; }
  .facts dt { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 6px 0 0; font-family: var(--display); font-weight: 600; letter-spacing: -0.01em; font-size: 1.05rem; color: var(--heading); }
  .caps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 40px; counter-reset: c; border-top: 1px solid var(--rule-strong); }
  .caps li { counter-increment: c; padding: 20px 0 20px 2.6rem; border-bottom: 1px solid var(--rule); position: relative; }
  .caps li::before { content: counter(c, decimal-leading-zero); position: absolute; left: 0; top: 24px; font-family: var(--display); font-weight: 700; font-size: 0.78rem; color: var(--accent); }
  .caps h3 { font-size: 1.1rem; margin: 0 0 4px; }
  .caps p { margin: 0; color: var(--muted); font-size: 0.97rem; }
  .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 40px 32px; }
  .ladder { margin-top: 40px; grid-template-columns: repeat(4, 1fr); }
  .ladder .col:last-child { border-top-color: var(--vermilion); }
  .who { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #f2a493 !important; margin: 0 0 10px !important; }
  .note { margin-top: 36px; font-size: 0.92rem; color: #9aa5b8; max-width: 70ch; }
  .sources { margin-top: 24px; font-size: 0.9rem; }
  @media (max-width: 1000px) { .ladder { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .intro, .caps, .shots { grid-template-columns: 1fr; } .facts { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .ladder { grid-template-columns: 1fr; } }
</style>
