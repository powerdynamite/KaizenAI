---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';

const capabilities = [
  { title: 'Portfolios & programs', body: 'Group related projects and roll up health, cost and risk for oversight.' },
  { title: 'Demand & idea intake', body: 'Capture ideas, cost them as proposals and approve the right work before it starts.' },
  { title: 'Interactive scheduling', body: 'A Gantt chart with WBS, dependencies, baselines and drag-to-reschedule, plus a Kanban board.' },
  { title: 'Financial management', body: 'Budget, forecast and actuals by period, including labour cost from resource rates.' },
  { title: 'Resource management', body: 'Resource requests, capacity heatmaps, bookings and weekly timesheets.' },
  { title: 'Risk & issues', body: 'Drag-and-drop 5×5 risk matrix, issue tracking and mitigation to closure.' },
  { title: 'Governance registers', body: 'Change requests, decisions, deliverables, stakeholders and lessons learned.' },
  { title: 'Status reporting', body: 'Periodic RAG health reports per project, rolled up to an executive dashboard.' },
  { title: 'Agile delivery', body: 'Buckets, sprints and labels for teams that work iteratively.' },
  { title: 'Data migration', body: 'Built to receive data from Project Online, MS Project, Project for the Web and Planner.' },
];

const shots = [
  { src: '/images/ppm/executive-dashboard.png', alt: 'Executive dashboard with portfolio health, cost roll-up and timeline', caption: 'Executive dashboard' },
  { src: '/images/ppm/the-kanban-board.png', alt: 'Kanban board with task cards in buckets', caption: 'Kanban board' },
  { src: '/images/ppm/budget-forecast-actual.png', alt: 'Financial grid showing budget, forecast and actual by period', caption: 'Budget, forecast & actuals' },
  { src: '/images/ppm/resource-management-standalone.png', alt: 'Resource management capacity view', caption: 'Resource management' },
];

const ladder = [
  { rung: 'Capture', who: 'You, assisted by AI', body: 'Create tasks, risks and status updates from plain language, so there is less typing.' },
  { rung: 'Surface', who: 'You ask, AI retrieves', body: '“Which of my projects are over budget?” is answered in plain English, security-trimmed to you.' },
  { rung: 'Interpret', who: 'AI explains, never sets', body: 'Health and slippage are calculated by rules. AI explains them and cites the records behind them.' },
  { rung: 'Decide', who: 'Always a human', body: 'AI can propose and rank options. A person approves before anything is committed.' },
];
---
<Base title="Kaizen PPM: Project & Portfolio Management on Power Platform" description="Kaizen PPM is project and portfolio management built natively on Microsoft Dataverse, with Gantt, Kanban, financials, resources, risk and Copilot/Cowork-ready AI.">
  <section class="page-hero">
    <div class="container hero">
      <div>
        <span class="eyebrow">Kaizen PPM</span>
        <h1>Project & portfolio management that lives in your Dataverse</h1>
        <p class="lead">
          Take work from idea to proposal, project and portfolio in one Power Platform app. It includes the interactive views
          PMs expect, the governance PMOs need, and AI that explains instead of guessing.
        </p>
        <div class="btn-row">
          <a href="/contact/?topic=Kaizen%20PPM%20demo" class="btn btn--primary">Request a demo</a>
          <a href="#capabilities" class="btn btn--ghost">See capabilities</a>
        </div>
      </div>
      <ul class="facts">
        <li><strong>100%</strong><span>inside your own Microsoft 365 tenant</span></li>
        <li><strong>10</strong><span>capability areas, idea to close</span></li>
        <li><strong>Native</strong><span>Dataverse security, Power BI and Teams</span></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <figure class="shot big">
        <img src="/images/ppm/the-interactive-gantt.png" alt="Kaizen PPM Gantt chart with WBS grid, dependencies and milestones" width="1918" height="670" />
        <figcaption>The interactive Gantt: WBS, dependencies, baselines, drag-to-reschedule and MS Project export.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--alt" id="capabilities">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Capabilities</span>
        <h2>Everything a PMO runs on, in one model</h2>
      </div>
      <div class="grid grid--3">
        {capabilities.map((c) => (
          <div class="cap"><h3>{c.title}</h3><p class="muted">{c.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><span class="eyebrow">A closer look</span><h2>Built for real delivery work</h2></div>
      <div class="grid shots">
        {shots.map((s) => (
          <figure class="shot">
            <img src={s.src} alt={s.alt} loading="lazy" />
            <figcaption>{s.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Copilot & Cowork</span>
        <h2>AI that explains rather than invents</h2>
        <p>
          Kaizen PPM is being extended with Microsoft Copilot and Cowork. Our rule is simple: AI helps you get data in and
          answers out, and explains the numbers. It never quietly sets a project’s health or makes the call for you.
        </p>
      </div>
      <ol class="ladder">
        {ladder.map((l, i) => (
          <li>
            <span class="rung">{i + 1}</span>
            <div><h3>{l.rung}</h3><span class="who">{l.who}</span><p>{l.body}</p></div>
          </li>
        ))}
      </ol>
      <p class="note">AI features are rolling out in waves. Each one is security-trimmed to the user, labelled when AI-assisted, and can be switched off per environment. Ask us what is available today.</p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <span class="eyebrow">Migration</span>
        <h2>Leaving Project Online or Planner?</h2>
        <p class="lead">Every record in Kaizen PPM can carry its source-system lineage: where it came from, its original ID and when it last synced. Bringing your history across does not mean restructuring later.</p>
      </div>
      <ul class="checklist">
        <li>Microsoft Project Online</li>
        <li>Project for the Web & Planner Premium</li>
        <li>Microsoft Planner</li>
        <li>Desktop MS Project (XML import & export)</li>
        <li>Spreadsheets and CSV</li>
      </ul>
    </div>
  </section>

  <CTA title="See Kaizen PPM on your own projects" body="Book a walkthrough. We can load a sample of your real project data so you see how it fits." />
</Base>
<style>
  .hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: center; }
  .facts { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .facts li { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px 22px; }
  .facts strong { display: block; font-family: var(--font-head); font-size: 1.6rem; color: var(--vermilion); }
  .facts span { color: var(--muted); font-size: 0.95rem; }
  .shot { margin: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--card); box-shadow: var(--shadow); }
  .shot img { background: #fff; width: 100%; }
  .shot figcaption { padding: 12px 18px; font-size: 0.9rem; color: var(--muted); border-top: 1px solid var(--line); }
  .shots { grid-template-columns: 1fr 1fr; }
  @media (max-width: 700px) { .shots { grid-template-columns: 1fr; } }
  .cap { border-top: 2px solid var(--vermilion); padding-top: 18px; }
  .ladder { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .ladder li { background: var(--ink-2); border: 1px solid #2a3650; border-radius: var(--radius); padding: 22px; display: grid; gap: 12px; align-content: start; }
  .ladder li:last-child { border-color: var(--vermilion); }
  .rung { width: 34px; height: 34px; border-radius: 50%; background: var(--vermilion); color: #fff; display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; }
  .ladder h3 { margin: 0; }
  .who { font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.08em; color: #f2a493; }
  .ladder p { margin: 8px 0 0; font-size: 0.95rem; }
  .note { margin-top: 28px; font-size: 0.92rem; color: #9aa5b8; max-width: 80ch; }
  .split { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; }
  @media (max-width: 960px) { .ladder { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .hero, .split { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .ladder { grid-template-columns: 1fr; } }
</style>
