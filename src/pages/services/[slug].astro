---
import Base from '../../layouts/Base.astro';
import CTA from '../../components/CTA.astro';
import Faqs from '../../components/Faqs.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { services, type Service } from '../../data/services';
import { serviceNode, faqPage, breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service: s } = Astro.props as { service: Service };
const idx = services.findIndex((o) => o.slug === s.slug);
const others = services.filter((o) => o.slug !== s.slug);
const path = `/services/${s.slug}/`;
const crumbs = [{ name: 'Services', path: '/services/' }, { name: s.title, path }];
const roman = ['i.', 'ii.', 'iii.', 'iv.', 'v.', 'vi.'];
---
<Base
  title={s.seoTitle}
  description={s.metaDescription}
  markdown={`/services/${s.slug}.md`}
  image={`/og/services/${s.slug}.png`}
  schema={[serviceNode(s), faqPage(s.faqs, path), breadcrumbs(crumbs)]}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="label"><b>{String(idx + 1).padStart(2, '0')}</b>{s.serviceType}</span>
      <h1>{s.title}</h1>
      <div class="intro">
        <p class="definition">{s.definition}</p>
        <div>
          <p class="lead">{s.summary}</p>
          <div class="actions">
            <a href={`/contact/?topic=${encodeURIComponent(s.title)}`} class="btn">Discuss your project <span class="arr">→</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container split">
      <div><span class="label"><b>A</b>Outcomes</span><h2 class="side-h">What you get</h2><p class="side-p">The results this work is designed to deliver.</p></div>
      <ol class="outcomes">
        {s.outcomes.map((o) => <li>{o}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><span class="label"><b>B</b>Offerings</span><h2 class="side-h">How we help</h2><p class="side-p">Pick one, or combine them. Most work starts small and grows.</p><p class="side-note"><strong>Have a specific need?</strong><a href={`/contact/?topic=${encodeURIComponent(s.title)}`}>Describe it in a few lines →</a></p></div>
      <div class="cols two">
        {s.offerings.map((o, i) => (
          <div class="col"><span class="n">{roman[i]}</span><h3>{o.title}</h3><p>{o.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div><span class="label"><b>C</b>Use cases</span><h2 class="side-h">Where it pays off</h2></div>
      <div>
        <ul class="cases">
          {s.useCases.map((u) => (
            <li><h3>{u.title}</h3><p>{u.body}</p></li>
          ))}
        </ul>
        <p class="muted note">Typical scenarios. Every engagement starts from your own process.</p>
        <p class="label stack-label">Tools we use</p>
        <p class="tags">{s.stack.map((t) => <span>{t}</span>)}</p>
      </div>
    </div>
  </section>

  <Faqs faqs={s.faqs} title={`${s.title}: common questions`} />

  <section class="section">
    <div class="container split">
      <div><span class="label"><b>→</b>Related</span><h2 class="side-h">Other services</h2></div>
      <ol class="rows">
        {others.map((o) => (
          <li>
            <a class="row-link" href={`/services/${o.slug}/`}>
              <span class="num">{String(services.indexOf(o) + 1).padStart(2, '0')}</span>
              <span class="title">{o.title}</span>
              <span class="desc">{o.short}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <CTA />
</Base>
<style>
  .intro { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; border-top: 1px solid var(--rule-strong); padding-top: 32px; margin-top: 12px; }
  .intro .lead { margin-bottom: 28px; }
  .outcomes { list-style: none; margin: 0; padding: 0; counter-reset: o; }
  .outcomes li {
    counter-increment: o; font-family: var(--display); font-weight: 600; letter-spacing: -0.02em; font-size: clamp(1.3rem, 2.6vw, 2rem); line-height: 1.25;
    color: var(--heading); padding: 18px 0 18px 3rem; border-top: 1px solid var(--rule); position: relative;
  }
  .outcomes li:first-child { border-top-color: var(--rule-strong); }
  .outcomes li::before { content: counter(o, decimal-leading-zero); position: absolute; left: 0; top: 28px; font-family: var(--display); font-weight: 700; font-size: 0.8rem; color: var(--accent); }
  .cases { list-style: none; margin: 0; padding: 0; }
  .cases li { display: grid; grid-template-columns: 1fr 1.4fr; gap: 12px 40px; padding: 24px 0; border-top: 1px solid var(--rule); }
  .cases li:first-child { border-top-color: var(--rule-strong); }
  .cases h3 { margin: 0; }
  .cases p { margin: 0; color: var(--muted); }
  .note { font-size: 0.9rem; margin: 16px 0 48px; }
  .stack-label { margin-bottom: 6px; }
  @media (max-width: 860px) { .intro, .cases li { grid-template-columns: 1fr; } }
</style>
