---
// Language menu. Hand-translated pages link to each other; every other page
// opens Google's free machine translation of the current page.
import { LANGS, machineUrl, type Lang, type Family } from '../i18n/strings';
interface Props { lang: Lang; alternates?: Family }
const { lang, alternates } = Astro.props;
const path = Astro.url.pathname;
const label = { en: 'Language', de: 'Sprache', ar: 'اللغة' }[lang];
const machine = { en: 'machine translation', de: 'maschinelle Übersetzung', ar: 'ترجمة آلية' };
const items = LANGS.map((x) => {
  if (alternates) return { ...x, href: x[alternates], auto: false };
  if (x.code === 'en') return { ...x, href: path, auto: false };
  return { ...x, href: machineUrl(path, x.code), auto: true };
});
---
<details class="lang">
  <summary aria-label={label}>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.8 3.9 5.8 3.9 9s-1.3 6.2-3.9 9c-2.6-2.8-3.9-5.8-3.9-9S9.4 5.8 12 3z"/></svg>
    <span>{lang.toUpperCase()}</span>
  </summary>
  <ul>
    {items.map((x) => (
      <li>
        <a href={x.href} hreflang={x.code} lang={x.code} aria-current={x.code === lang ? 'true' : undefined} target={x.auto ? '_blank' : undefined} rel={x.auto ? 'noopener' : undefined}>
          {x.name}{x.auto && <small> · {machine[x.code]}</small>}
        </a>
      </li>
    ))}
  </ul>
</details>
<style>
  .lang { position: relative; }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; height: 34px; padding: 0 8px; border: 0; border-radius: var(--radius); color: var(--muted); font: 600 0.8rem var(--display); }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .lang[open] summary { color: var(--heading); background: var(--rule); }
  ul { position: absolute; top: calc(100% + 6px); inset-inline-end: 0; z-index: 70; list-style: none; margin: 0; padding: 6px; min-width: 230px; background: var(--bg); border: 1px solid var(--rule-strong); border-radius: var(--radius); box-shadow: 0 10px 30px rgba(0,0,0,0.12); }
  a { display: block; padding: 9px 10px; border-radius: 6px; color: var(--text); text-decoration: none; font-size: 0.93rem; }
  a:hover { background: var(--bg-2); color: var(--accent); }
  a[aria-current='true'] { font-weight: 600; color: var(--heading); }
  small { color: var(--muted); font-size: 0.78rem; }
</style>
