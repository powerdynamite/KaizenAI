---
import Logo from './Logo.astro';
import { NAV } from '../config';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="KaizenAI home"><Logo /></a>
    <div class="tools">
      <button class="theme-btn" type="button" aria-label="Switch to dark mode" title="Switch light / dark">
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
    <nav id="site-nav" class="nav" aria-label="Main">
      {NAV.map((n) => (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
      ))}
      <a href="/contact/" class="btn nav-cta">Contact us</a>
    </nav>
  </div>
</header>
<style>
  .site-header { background: var(--bg); border-bottom: 1px solid var(--rule); position: relative; z-index: 50; }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand { text-decoration: none; }
  .nav { display: flex; align-items: center; gap: 26px; }
  .nav a:not(.btn) { color: var(--text); text-decoration: none; font-size: 0.95rem; font-weight: 500; padding: 4px 0; border-bottom: 2px solid transparent; }
  .nav a:not(.btn):hover { color: var(--accent); }
  .nav a[aria-current='page'] { border-bottom-color: var(--vermilion); }
  .nav-cta { padding: 10px 18px; }
  .bar { gap: 16px; }
  .tools { order: 3; display: flex; align-items: center; gap: 8px; }
  .theme-btn { display: grid; place-items: center; width: 38px; height: 38px; border-radius: var(--radius); border: 1px solid var(--rule); background: transparent; color: var(--heading); cursor: pointer; }
  .theme-btn:hover { border-color: var(--rule-strong); }
  .theme-btn .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-btn .i-sun { display: block; }
  :global(:root[data-theme="dark"]) .theme-btn .i-moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-btn .i-sun { display: block; }
    :global(:root:not([data-theme="light"])) .theme-btn .i-moon { display: none; }
  }
  .nav { margin-left: auto; }
  .menu-btn {
    display: none; background: none; border: 1px solid var(--rule-strong); color: var(--heading); border-radius: var(--radius);
    font: 600 0.85rem var(--display); padding: 8px 14px; cursor: pointer;
  }
  @media (max-width: 1000px) {
    .menu-btn { display: block; }
    .nav {
      position: absolute; top: 72px; left: 0; right: 0; display: none;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--bg); border-bottom: 1px solid var(--rule-strong); padding: 0 var(--gutter) 20px;
    }
    .nav.open { display: flex; }
    .nav a:not(.btn) { padding: 16px 0; border-bottom: 1px solid var(--rule); font-family: var(--display); font-weight: 600; font-size: 1.25rem; }
    .nav a[aria-current='page'] { border-bottom-color: var(--rule); color: var(--accent); }
    .nav-cta { margin-top: 18px; justify-content: center; }
  }
</style>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.textContent = open ? 'Menu' : 'Close';
    nav?.classList.toggle('open', !open);
  });

  // Light / dark switch: remembers the visitor's choice; otherwise follows the device.
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const label = () => themeBtn?.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
  label();
  themeBtn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('kz-theme', next); } catch (e) {}
    label();
  });
</script>
