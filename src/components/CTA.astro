---
interface Props { title?: string; body?: string }
const {
  title = 'Let’s make your business a little better every day.',
  body = 'Tell us what you are trying to fix. You get an honest answer on whether, and how, Microsoft and AI can help. No obligation.',
} = Astro.props;
---
<section class="section section--ink">
  <div class="container cta">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="btn-row">
      <a href="/contact/" class="btn btn--primary">Start a conversation</a>
      <a href="/services/" class="btn btn--ghost">Explore services</a>
    </div>
  </div>
</section>
<style>
  .cta { display: grid; grid-template-columns: 1.6fr 1fr; gap: 32px; align-items: center; }
  .cta p { max-width: 56ch; margin: 0; }
  .btn-row { justify-content: flex-end; }
  @media (max-width: 860px) { .cta { grid-template-columns: 1fr; } .btn-row { justify-content: flex-start; } }
</style>
