---
import { SITE } from '../config';
import { t, langInfo, type Lang } from '../i18n/strings';
interface Props { title?: string; body?: string; lang?: Lang }
const { lang = 'en' } = Astro.props;
const s = t(lang).cta;
const { title = s.title, body = s.body } = Astro.props;
const bookHref = SITE.bookingUrl || langInfo(lang).contact;
---
<section class="section section--tint cta">
  <div class="container split">
    <span class="label"><b>→</b>{s.next}</span>
    <div>
      <h2>{title}</h2>
      <p class="lead">{body}</p>
      <p class="mail"><a dir="ltr" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <div class="actions">
        <a href={bookHref} class="btn" target={SITE.bookingUrl ? '_blank' : undefined} rel={SITE.bookingUrl ? 'noopener' : undefined}>{s.button} <span class="arr">→</span></a>
        {SITE.whatsapp && <a href={`https://wa.me/${SITE.whatsapp}`} class="link-arrow" rel="noopener" target="_blank">{s.whatsapp}</a>}
      </div>
    </div>
  </div>
</section>
<style>
  .cta h2 { max-width: 18ch; }
  .mail { font-family: var(--display); font-weight: 600; letter-spacing: -0.02em; font-size: clamp(1.3rem, 3vw, 2.1rem); margin: 0.4em 0 1.2em; overflow-wrap: anywhere; }
  .mail a { color: var(--heading); text-decoration-color: var(--vermilion); text-decoration-thickness: 2px; text-underline-offset: 8px; }
  .mail a:hover { color: var(--accent); }
</style>
