---
// KaizenAI logo system (docs/brand/KaizenAI_Brand_Identity.pdf).
// variant 'tile' = primary mark in an ink tile; 'open' = compact open steps for nav bars.
interface Props { size?: number; variant?: 'tile' | 'open'; inverse?: boolean; wordmark?: boolean }
const { size = 32, variant = 'tile', inverse = false, wordmark = true } = Astro.props;
const tile = inverse ? '#F7F5F0' : '#0E1726';
const step = inverse ? '#0E1726' : '#F7F5F0';
const openStep = inverse ? '#F7F5F0' : '#0E1726';
---
<span class:list={['logo', { inverse }]}>
  {variant === 'tile' ? (
    <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
      <rect width="64" height="64" rx="14" fill={tile} />
      <rect x="13" y="38" width="10" height="13" rx="2.5" fill={step} />
      <rect x="27" y="28" width="10" height="23" rx="2.5" fill={step} />
      <rect x="41" y="13" width="10" height="38" rx="2.5" fill="#E2492F" />
    </svg>
  ) : (
    <svg width={size * 0.8} height={size} viewBox="13 13 38 38" aria-hidden="true">
      <rect x="13" y="38" width="10" height="13" rx="2.5" fill={openStep} />
      <rect x="27" y="28" width="10" height="23" rx="2.5" fill={openStep} />
      <rect x="41" y="13" width="10" height="38" rx="2.5" fill="#E2492F" />
    </svg>
  )}
  {wordmark && <span class="word">Kaizen<span class="ai">AI</span></span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; }
  .word { font-family: var(--display); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.03em; color: var(--heading); line-height: 1; }
  .inverse .word { color: #f7f5f0; }
  .ai { color: var(--vermilion); }
</style>
