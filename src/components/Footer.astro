---
import Logo from './Logo.astro';
import Kanji from './Kanji.astro';
import { SITE } from '../config';
import { services } from '../data/services';
import { t, langInfo, type Lang } from '../i18n/strings';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const f = t(lang).footer;
const nav = t(lang).nav;
const topics = t(lang).form.topics;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="sign"><Logo size={44} inverse /><p>{SITE.tagline}</p></div>
      <p class="motto"><Kanji height={22} class="kanji" /> <span>{f.motto}</span></p>
    </div>
    <div class="grid">
      <div>
        <h2 class="fh">{f.services}</h2>
        <ul>{services.map((s, i) => <li><a href={`/services/${s.slug}/`}>{lang === 'en' ? s.title : topics[i]}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="fh">{f.studio}</h2>
        <ul>
          <li><a href="/packages/">{nav.packages}</a></li>
          <li><a href="/products/kaizen-ppm/">Kaizen PPM</a></li>
          <li><a href="/experience/">{nav.experience}</a></li>
          <li><a href="/starter-kits/">{nav.kits}</a></li>
          <li><a href="/about/">{nav.about}</a></li>
          <li><a href="/blog/">{nav.blog}</a></li>
          <li><a href={langInfo(lang).contact}>{nav.contact}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="fh">{f.write}</h2>
        <ul>
          <li><a dir="ltr" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          {SITE.phones.map((p) => <li><a dir="ltr" href={`tel:${p.tel}`}>{p.display}</a></li>)}
          {SITE.social.linkedin && <li><a href={SITE.social.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>}
        </ul>
      </div>
      <div>
        <h2 class="fh">{f.agents}</h2>
        <ul>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="/llms-full.txt">llms-full.txt</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {SITE.name} · <a href="/privacy/">{f.privacy}</a></span>
      <span>{f.built}</span>
      <span>{f.trademark}</span>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--ink); color: #9aa5b8; padding: 64px 0 32px; font-size: 0.95rem; --rule: #253148; }
  .top { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; padding-bottom: 40px; border-bottom: 1px solid var(--rule); }
  .sign p { margin: 14px 0 0; color: #c9d1de; }
  .motto { margin: 0; display: flex; align-items: center; gap: 12px; color: #9aa5b8; font-size: 0.9rem; }
  .motto :global(.kanji) { color: #e2492f; }
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; padding: 40px 0; }
  .fh { font-family: var(--sans); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #f7f5f0; margin: 0 0 14px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 8px; overflow-wrap: anywhere; }
  a { color: #c9d1de; text-decoration: none; }
  a:hover { color: #fff; text-decoration: underline; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 24px; padding-top: 22px; font-size: 0.8rem; }
  .legal a { color: #9aa5b8; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
