---
import type { Faq } from '../data/services';
interface Props { faqs: Faq[]; title?: string; label?: string }
const { faqs, title = 'Questions people ask', label = 'FAQ' } = Astro.props;
---
<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container split">
    <div>
      <span class="label"><b>?</b>{label}</span>
      <h2 id="faq-title" class="t">{title}</h2>
    </div>
    <div class="faqs">
      {faqs.map((f) => (
        <details>
          <summary><h3>{f.q}</h3><span class="pm" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .t { font-size: clamp(1.5rem, 2.4vw, 2rem); max-width: 12ch; }
  .faqs { border-top: 1px solid var(--rule-strong); }
  details { border-bottom: 1px solid var(--rule); }
  summary { cursor: pointer; list-style: none; padding: 22px 0; display: flex; justify-content: space-between; gap: 24px; align-items: baseline; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 1.1rem; font-weight: 600; }
  summary:hover h3 { color: var(--accent); }
  .pm::before { content: '+'; font-family: var(--display); font-size: 1.3rem; color: var(--accent); }
  details[open] .pm::before { content: '–'; }
  details p { margin: 0 0 24px; color: var(--muted); max-width: 68ch; }
</style>
