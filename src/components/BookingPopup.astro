---
// Any link with data-booking opens the HubSpot Meetings booking page in a pop-up.
// Nothing loads until the first click. Without JavaScript, or with a modifier
// key, the link still opens the booking page in a new tab.
---
<dialog id="booking-dialog" class="booking" aria-label="Book a meeting">
  <button type="button" class="close" aria-label="Close" data-close>×</button>
  <iframe title="Book a meeting with KaizenAI" loading="lazy"></iframe>
</dialog>
<style>
  .booking { width: min(1000px, calc(100vw - 32px)); height: min(820px, calc(100vh - 48px)); padding: 0; border: 1px solid var(--rule-strong); border-radius: var(--radius); background: #fff; overflow: hidden; }
  .booking::backdrop { background: rgba(0, 0, 0, 0.55); }
  .booking iframe { width: 100%; height: 100%; border: 0; display: block; }
  .close { position: absolute; top: 8px; inset-inline-end: 10px; z-index: 1; width: 36px; height: 36px; border: 0; border-radius: 50%; background: rgba(0, 0, 0, 0.6); color: #fff; font-size: 1.4rem; line-height: 1; cursor: pointer; }
  .close:focus-visible { outline: 2px solid var(--vermilion); outline-offset: 2px; }
</style>
<script>
  const dialog = document.getElementById('booking-dialog') as HTMLDialogElement | null;
  const frame = dialog?.querySelector('iframe');
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-booking]');
    if (!link || !dialog || !frame || typeof dialog.showModal !== 'function') return;
    if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) return;
    e.preventDefault();
    const url = new URL(link.dataset.booking || link.href);
    url.searchParams.set('embed', 'true');
    if (frame.src !== url.href) frame.src = url.href;
    dialog.showModal();
  });
  dialog?.addEventListener('click', (e) => {
    // Close on the × button or on a click on the backdrop.
    if ((e.target as Element).closest('[data-close]') || e.target === dialog) dialog.close();
  });
</script>
