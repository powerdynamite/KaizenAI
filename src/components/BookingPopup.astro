---
// Any link with data-booking opens the HubSpot Meetings booking page in an
// on-page pop-up. The booking page loads only on the first click, and no
// HubSpot script runs on this site. Without JavaScript, or with Ctrl/Cmd/Shift
// held, the link opens the booking page in a new tab as usual.
---
<dialog id="booking" class="booking" aria-label="Book a meeting">
  <button class="close" type="button" aria-label="Close">×</button>
  <iframe title="Book a meeting with KaizenAI" loading="lazy"></iframe>
</dialog>
<style>
  .booking {
    width: min(1000px, calc(100vw - 32px));
    height: min(760px, calc(100dvh - 32px));
    padding: 0; border: 1px solid var(--rule); border-radius: var(--radius);
    background: #fff; overflow: hidden;
  }
  .booking::backdrop { background: rgb(14 23 38 / 0.6); }
  .booking iframe { width: 100%; height: 100%; border: 0; display: block; }
  .close {
    position: absolute; top: 8px; inset-inline-end: 8px; width: 40px; height: 40px;
    border: 0; border-radius: 50%; background: var(--ink); color: var(--paper);
    font-size: 1.5rem; line-height: 1; cursor: pointer;
  }
  .close:focus-visible { outline: 2px solid var(--vermilion); outline-offset: 2px; }
</style>
<script>
  const dialog = document.getElementById('booking') as HTMLDialogElement | null;
  const frame = dialog?.querySelector('iframe');
  dialog?.querySelector('.close')?.addEventListener('click', () => dialog.close());
  // Click on the dark backdrop closes it.
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-booking]');
    if (!link || !dialog || !frame || typeof dialog.showModal !== 'function') return;
    if (e.ctrlKey || e.metaKey || e.shiftKey) return;
    e.preventDefault();
    const url = new URL(link.dataset.booking || link.href);
    url.searchParams.set('embed', 'true');
    if (frame.src !== url.href) frame.src = url.href;
    dialog.showModal();
  });
</script>
