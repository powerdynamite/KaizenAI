---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import sansLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import displayLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AgentTools from '../components/AgentTools.astro';
import { SITE } from '../config';
import { graph } from '../lib/schema';
import ArabicFont from '../components/ArabicFont.astro';
import CalendlyPopup from '../components/CalendlyPopup.astro';
import { LANGS, langInfo, t, type Lang } from '../i18n/strings';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Path of the Markdown version of this page, e.g. '/services/ai-agents.md'. */
  markdown?: string;
  /** Extra JSON-LD nodes; Organization and WebSite are always included. */
  schema?: object[];
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  lang?: Lang;
  /** Hand-translated page family: 'home' or 'contact'. Adds hreflang links. */
  alternates?: 'home' | 'contact';
}
const {
  title,
  description = SITE.description,
  image = '/og-image.png',
  type = 'website',
  markdown,
  schema = [],
  publishedTime,
  modifiedTime,
  noindex = false,
  lang = 'en',
  alternates,
} = Astro.props;
const L = langInfo(lang);
const tx = t(lang);

const fullTitle = title ? (title.includes(SITE.name) ? title : `${title} | ${SITE.name}`) : `${SITE.name}: AI Agents, Copilot & Dynamics 365 Experts`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const ld = graph(...schema);
const isContact = /\/(contact|kontakt)\//.test(Astro.url.pathname);
---
<!doctype html>
<html lang={lang} dir={L.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={SITE.founder} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="KaizenAI Blog" href="/rss.xml" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown version of this page" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {alternates && LANGS.map((x) => <link rel="alternate" hreflang={x.code} href={new URL(alternates === 'home' ? x.home : x.contact, Astro.site)} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates === 'home' ? '/' : '/contact/', Astro.site)} />}
    <meta name="theme-color" content="#0E1726" />
    <script is:inline>try{var t=localStorage.getItem('kz-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t;}catch(e){}</script>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={{ en: 'en_US', de: 'de_DE', ar: 'ar_AE' }[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class:list={{ 'has-cta-bar': !isContact }}>
    {lang === 'ar' && <ArabicFont />}
    <a class="skip-link" href="#main">{{ en: 'Skip to content', de: 'Zum Inhalt springen', ar: 'انتقل إلى المحتوى' }[lang]}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {!isContact && (
      <div class="cta-bar" role="complementary" aria-label="Contact KaizenAI">
        <a href={L.contact} class="btn" {...(SITE.bookingUrl ? { href: SITE.bookingUrl, target: '_blank', rel: 'noopener', 'data-calendly': SITE.bookingUrl } : {})}>{tx.ctaBar} <span class="arr">→</span></a>
        {SITE.whatsapp && <a class="wa" href={`https://wa.me/${SITE.whatsapp}`} rel="noopener" target="_blank" aria-label="Message KaizenAI on WhatsApp">WhatsApp</a>}
      </div>
    )}
    <AgentTools />
    {SITE.bookingUrl && <CalendlyPopup />}
    {SITE.cloudflareAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: SITE.cloudflareAnalyticsToken })}></script>
    )}
  </body>
</html>
